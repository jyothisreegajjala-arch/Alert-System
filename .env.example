# SafeReach Environment Configuration Example
PORT=3000
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/safereach?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safereach?retryWrites=true&w=majority
